# ~/.config/zelenogorye/.env — права 600, в git не кладётся.
NODE_ENV=production
PORT=3000
DB_PATH=/Users/rustem/srv/zelenogorye/data/zg.sqlite
COOKIE_SECURE=true
PUBLIC_ORIGIN=https://zg.example.com
LOG_LEVEL=info

# Бэкап: основной каталог по умолчанию data/backups; зеркало — внешний диск или iCloud Drive.
# BACKUP_MIRROR=/Volumes/Backup/zelenogorye
# Для страницы «Состояние».
NGINX_BIN=/opt/homebrew/bin/nginx
CF_IPS_FILE=/Users/rustem/srv/zelenogorye/data/ops-state/cloudflare-allow.conf

# Jev (TypeSafe). Функции включать по итогам этапа J0.
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_LEAK_GUARD=false
JEV_DIARY_MATCH=false
JEV_ROLL_INTENT=false
JEV_GREEN_MAGIC=false

# Claude API (сводки).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SUMMARY=claude-sonnet-5-5
ANTHROPIC_MODEL_DRAFT=claude-haiku-4-5

# DDNS — только если внешний IP не статический. Токен Cloudflare с правом Zone.DNS:Edit на одну зону.
CF_API_TOKEN=
CF_ZONE_ID=
CF_RECORD_NAME=zg.example.com
